# NEXUS demo MVP — public environment variables.
#
# Only VITE_-prefixed variables are inlined into the browser bundle at build
# time. Anything you put here is PUBLIC: never add API keys, tokens, or other
# secrets in this file or in any .env file committed to the repo.
#
# Copy to `.env.local` to experiment. In demo mode the app runs fully without
# any of these variables; leave them empty for a pure local demo.

# "demo" (default) shows honest demo-mode banners; "production" hides them.
VITE_APP_MODE=demo

# Base path when the site is served from a repository subpath on GitHub Pages.
VITE_BASE_PATH=/

# Phase 2 placeholders — these are intentionally NOT functional yet. If set,
# the Integrations page only marks the connection as "configured".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AI_BACKEND_URL=